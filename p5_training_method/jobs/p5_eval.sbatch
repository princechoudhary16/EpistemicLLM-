#!/bin/bash
#SBATCH --partition=MGPU-TC2
#SBATCH --qos=normal
#SBATCH --nodes=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=00:30:00
#SBATCH --job-name=p5_eval
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -eo pipefail
cd "$SLURM_SUBMIT_DIR"

module load cuda/12.8.0
export CPATH="/apps/cuda_12.8.0/include:${CPATH:-}"
source /apps/anaconda3-2025.06-0/etc/profile.d/conda.sh
conda activate ~/envs/ntu-gpu
export HF_HOME="$HOME/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false

nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv

: "${CHECKPOINT:?Set CHECKPOINT=results/raw/p5/<run_id>/checkpoint}"
DATA="${DATA:-data/synthetic/main_v0/eval.jsonl}"
# EVAL_ARGS e.g. "--split final --allow-final"; default scores the dev questions only
python p5_training_method/eval_head.py --checkpoint "$CHECKPOINT" --data "$DATA" ${EVAL_ARGS:-}
